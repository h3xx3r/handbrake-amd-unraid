HANDBRAKE_REF=master

TZ=Europe/Berlin
LANG=de_DE.UTF-8
USER_ID=99
GROUP_ID=100
UMASK=0022

WEB_PORT=5800
VNC_PORT=5901
VNC_PASSWORD=
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

LIBVA_DRIVER_NAME=radeonsi
VAAPI_DEVICE=/dev/dri/renderD128

WATCH_ENABLED=1
WATCH_PROFILE=rx6700-hevc10
WATCH_QUALITY=24
WATCH_HANDBRAKE_PRESET=Fast 1080p30
WATCH_POLL_SECONDS=5
WATCH_SETTLE_SECONDS=3

CONFIG_PATH=/mnt/user/appdata/handbrake-amd
STORAGE_PATH=/mnt/user
OUTPUT_PATH=/mnt/user/Media/HandBrake
WATCH_PATH=/mnt/user/Media/HandBrake/watch
